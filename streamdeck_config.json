    "1": { "label": "Next",  "icon": "next",  "color": "22CC44", "type": "media",  "action": "next" },
    "2": { "label": "Prev",  "icon": "prev",  "color": "22CC44", "type": "media",  "action": "previous" },
    "3": { "label": "Vol +", "icon": "volup", "color": "22AAFF", "type": "media",  "action": "volume_up" },
    "4": { "label": "Vol -", "icon": "voldn", "color": "22AAFF", "type": "media",  "action": "volume_down" },
    "5": { "label": "Mute",  "icon": "mute",  "color": "FF3311", "type": "media",  "action": "mute" },
